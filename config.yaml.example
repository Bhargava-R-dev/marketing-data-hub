db_path: data/hub.duckdb
secrets_dir: secrets
exports_dir: exports

connectors:
  ga4:
    schedule: "0 6 * * *"
    window_days: 30
    options:
      property_ids: ["123456789", "987654321"]   # or property_id: "123..." for one
      # identities:                # properties living under a DIFFERENT Google login
      #   "987654321": personal    # -> uses secrets/google_token_personal.json
      #   (add logins with: hub login personal; then: hub accounts --identity personal --add)
      # reports: [core, channels]  # optional: limit which report shapes sync
      #   (ga4 has: core, channels, landing_pages, pages, audience, visitors, events)
  gsc:
    schedule: "0 6 * * *"
    options:
      site_urls: ["sc-domain:example.com", "https://shop.example.com/"]  # or site_url: ...
      # reports: [core, queries]   # optional (gsc has: core, queries, pages,
      #   devices, countries); core totals are exact, breakdowns undercount
      #   slightly because Google anonymises rare queries
      # brand_terms:                # tags queries rows branded=true/false at sync
      #   "sc-domain:example.com": [example, "example brand"]
  youtube:
    schedule: "0 6 * * *"
    options: {}
  # google_ads:            # activate when you have a developer token (see SETUP.md)
  #   options:
  #     developer_token: "..."          # ads.google.com > Tools & Settings > API Center
  #     customer_ids: ["123-456-7890", "222-333-4444"]   # one or many
  #     login_customer_id: "999-888-7777"   # your MCC/manager id if using one
  #     labels:
  #       "123-456-7890": "Client A"
  #     # identity: personal   # if the Ads login is a non-default Google identity
  # meta_ads:              # activate when you have a Meta app + token (see SETUP.md)
  #   options:
  #     access_token: "..."             # long-lived token with ads_read
  #     ad_account_ids: ["act_123", "act_456"]           # one or many
  #     labels:
  #       "act_123": "Client A"

exports:
  - name: daily_overview
    fields: [date, source, impressions, clicks, spend, sessions, conversions]
    date_preset: last_30d
